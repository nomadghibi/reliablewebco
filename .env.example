# ===========================================
# Reliable Web Studio Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# Stripe Payment Links
# Create these at: https://dashboard.stripe.com/payment-links
# These control checkout availability. If blank/invalid, users are routed to /contact.
# Server-only because the Local Website Plan routes through /checkout first.
STRIPE_LOCAL_WEBSITE_LINK=
NEXT_PUBLIC_STRIPE_LANDING_PAGE_LINK=
NEXT_PUBLIC_STRIPE_LEAD_SPRINT_LINK=
NEXT_PUBLIC_STRIPE_WEBSITE_DEPOSIT_LINK=
NEXT_PUBLIC_STRIPE_CARE_BASIC_LINK=
NEXT_PUBLIC_STRIPE_CARE_STANDARD_LINK=
NEXT_PUBLIC_STRIPE_CARE_PRO_LINK=

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional server-side endpoint for website audit requests
# Defaults to existing Formspree endpoint if not set.
FORMSPREE_AUDIT_ENDPOINT=

# Optional separate destination for paid customer onboarding.
# Defaults to the existing Reliable Web Studio Formspree inbox if not set.
FORMSPREE_ONBOARDING_ENDPOINT=

# Optional profile links used in Organization/LocalBusiness schema
NEXT_PUBLIC_GBP_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
